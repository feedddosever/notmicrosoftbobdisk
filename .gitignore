# Secrets and credentials
.env*
*.pem
*.key

# Personal editor and agent settings
.claude/settings.local.json

# Hosting / recording tooling
.vercel/
.obs/
*.mkv
*.mp4

# Local caches and environments
build/cache/
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Volatile run outputs (the certificate and golden data are committed)
reports/smoke_last.json
reports/last_run.json

# Never committed: local notes
plan/
.local/

# Office lock files (a workbook open in Excel)
~$*

# Raw Bob IDE task exports (they hold home paths); tools/import_bob_export.py writes the
# scrubbed copy into bob_sessions/
bob-task-*.json
